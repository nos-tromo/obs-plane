# Copy to .env and set GRAFANA_ADMIN_PASSWORD and AUDIT_EDGE_SECRET at minimum.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-set-a-real-password
GRAFANA_HOST_PORT=3001
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=720h
INFERENCE_NET=inference-net
DATA_NET=data-net
EDGE_NET=edge-net
# LAN hostname/IP users type into the browser for the gateway route
# (`https://<EDGE_HOST>/grafana/`) — see edge-plane's .env.example.
EDGE_HOST=127.0.0.1
# Org role auto-assigned to auth.proxy-provisioned users (jane.doe et al).
GRAFANA_VIEWER_ROLE=Viewer
# Edge secret for Grafana (optional): grafana-guard passes the gateway's
# identity headers on only when its X-Edge-Secret matches this value.
# Same value as GRAFANA_EDGE_SECRET in edge-plane's .env; generate it there
# with `make secret`. Empty -> identity headers are trusted from any caller
# on edge-net, as before the guard.
GRAFANA_EDGE_SECRET=
# GPU hosts only: set to `gpu` to enable dcgm-exporter (requires the NVIDIA
# container toolkit). Leave empty on hosts without NVIDIA GPUs.
COMPOSE_PROFILES=
# Audit trail (docs/audit.md). Its own Grafana, served at
# `https://<EDGE_HOST>/audit/` to the gateway's `audit` group.
# Edge secret for the audit Grafana (required): grafana-audit-guard answers
# 403 to every request whose X-Edge-Secret is not this value. Same value as
# AUDIT_EDGE_SECRET in edge-plane's .env; generate it there with
# `make secret`. At least 32 characters — the placeholder below is refused.
AUDIT_EDGE_SECRET=change-me
# How long the audit store keeps lines (Loki duration). Set it to the period
# the applicable retention rules prescribe before the trail holds data;
# lowering it later deletes older lines for good.
AUDIT_RETENTION=8760h
# Seconds between verifier runs, and how long a chain may stay silent
# without a shutdown event before it is reported (5x the 60 s heartbeat).
AUDIT_VERIFY_INTERVAL=300
AUDIT_SILENCE_S=300
