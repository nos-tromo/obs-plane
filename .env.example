# obs-plane — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)

# =============================================================================
# Required
# =============================================================================

# Grafana's admin password (the local admin of the ops Grafana).
# [required] [secret]
GRAFANA_ADMIN_PASSWORD=

# The edge secret for the audit Grafana: grafana-audit-guard answers 403 to
# every request whose X-Edge-Secret is not this value. Same value as
# AUDIT_EDGE_SECRET in edge-plane's .env; generate it with
# `openssl rand -hex 32`. At least 32 characters -- a shorter one is refused.
# [required] [secret] [shared: edge-plane]
AUDIT_EDGE_SECRET=

# The LAN hostname or IP users type into the browser for the gateway route
# (`https://<EDGE_HOST>/grafana/`). The same value as EDGE_HOST in edge-plane's
# .env, which holds it; make env fills it.
# [required] [shared: edge-plane]
EDGE_HOST=

# =============================================================================
# Auth & identity
# =============================================================================

# Grafana's admin user.
# GRAFANA_ADMIN_USER=admin

# Org role auto-assigned to auth.proxy-provisioned users.
# GRAFANA_VIEWER_ROLE=Viewer

# Edge secret for Grafana (optional): grafana-guard passes the gateway's
# identity headers on only when its X-Edge-Secret matches this value. Same
# value as GRAFANA_EDGE_SECRET in edge-plane's .env; generate it with
# `openssl rand -hex 32`. The default is empty: identity headers are then
# trusted from any caller on edge-net.
# [secret] [shared: edge-plane]
# GRAFANA_EDGE_SECRET=

# =============================================================================
# Network & proxy
# =============================================================================

# Names of the external networks. Created via `make network`. Override only if
# you renamed them.
# INFERENCE_NET=inference-net
# DATA_NET=data-net
# EDGE_NET=edge-net

# =============================================================================
# obs-plane
# =============================================================================

# GPU hosts only: set to `gpu` to enable dcgm-exporter (requires the NVIDIA
# container toolkit). Leave empty on hosts without NVIDIA GPUs.
# COMPOSE_PROFILES=

# =============================================================================
# Audit & retention
# =============================================================================

# How long Prometheus and Loki keep their data (a Prometheus and a Loki
# duration).
# PROMETHEUS_RETENTION=30d
# LOKI_RETENTION=720h

# Audit trail (docs/audit.md). Its own Grafana, served at
# `https://<EDGE_HOST>/audit/` to the gateway's `audit` group.
# How long the audit store keeps lines (Loki duration). Set it to the period
# the applicable retention rules prescribe before the trail holds data;
# lowering it later deletes older lines for good.
# AUDIT_RETENTION=8760h

# Seconds between verifier runs, and how long a chain may stay silent
# without a shutdown event before it is reported (5x the 60 s heartbeat).
# AUDIT_VERIFY_INTERVAL=300
# AUDIT_SILENCE_S=300

# The containers whose hash-chained lines count, as compose project/service
# pairs (docs/audit.md, "Source binding"). Empty: the federation's emitters
# built into the verifier. Set it only to add or rename an emitter, e.g.
#   AUDIT_EMITTERS=docint/backend,nextext/backend,translator/backend,vllm-service/router,edge-plane/auth-audit,data-plane/admin-audit,open-webui-service/retention
# AUDIT_EMITTERS=

# =============================================================================
# Development only
# =============================================================================

# Host port the dev overlay (make up-dev) publishes Grafana on.
# [dev]
# GRAFANA_HOST_PORT=3001
