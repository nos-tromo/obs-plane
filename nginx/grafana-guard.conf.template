# grafana-guard: the only listener on :3000 in grafana's network namespace
# (docs/grafana-access.md).
#
# Grafana signs users in from X-Auth-User but cannot tell who sent it, and
# edge-net is shared with every app frontend. So Grafana listens on
# 127.0.0.1:3001 only, and this nginx passes the identity headers on only
# when X-Edge-Secret equals GRAFANA_EDGE_SECRET, the value the edge gateway
# sends; otherwise it drops them and Grafana shows its login form, the
# admin's fallback. With the secret unset, both sides are empty and every
# request passes them, as before this guard existed.
#
# Rendered by the image's entrypoint: envsubst replaces only defined
# environment variables, so nginx's own $variables stay as they are.
# compose always defines EDGE_SECRET (possibly empty) for that reason.

log_format scrubbed '$time_iso8601 "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time "$http_x_request_id"';

map $edge_verified $grafana_auth_user   { 1 $http_x_auth_user;   default ""; }
map $edge_verified $grafana_auth_email  { 1 $http_x_auth_email;  default ""; }
map $edge_verified $grafana_auth_groups { 1 $http_x_auth_groups; default ""; }
map $edge_verified $grafana_auth_name   { 1 $http_x_auth_name;   default ""; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 3000;
    server_tokens off;
    access_log /var/log/nginx/access.log scrubbed;

    # Exact, case-sensitive string comparison.
    set $edge_verified 0;
    if ($http_x_edge_secret = "${EDGE_SECRET}") {
        set $edge_verified 1;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Grafana Live (websocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # An empty value makes nginx omit the header, so an unverified
        # request reaches Grafana without any identity header.
        proxy_set_header X-Auth-User $grafana_auth_user;
        proxy_set_header X-Auth-Email $grafana_auth_email;
        proxy_set_header X-Auth-Groups $grafana_auth_groups;
        proxy_set_header X-Auth-Name $grafana_auth_name;
        proxy_set_header X-Edge-Secret "";
    }
}
