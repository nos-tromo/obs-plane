# grafana-audit-guard: the only listener on :3000 in grafana-audit's network
# namespace (docs/audit.md#access).
#
# grafana-audit signs readers in from X-Auth-User but cannot tell who sent
# it, and edge-net is shared with every app frontend. So Grafana listens on
# 127.0.0.1:3001 only, and this nginx answers 403 to every request whose
# X-Edge-Secret is not AUDIT_EDGE_SECRET, the value only the edge gateway
# sends. There is no unset mode: compose refuses to start without the secret.
#
# No access log: who read the trail is recorded once, in the gateway's access
# log, which is in the audit lane — not in the operational logs.
#
# Rendered by the image's entrypoint: envsubst replaces only defined
# environment variables, so nginx's own $variables stay as they are.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 3000;
    server_tokens off;
    access_log off;

    # Exact, case-sensitive string comparison.
    if ($http_x_edge_secret != "${EDGE_SECRET}") {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Grafana Live (websocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Edge-Secret "";
    }
}
