{
  "uid": "audit-trail",
  "title": "Audit trail",
  "description": "Every line of the audit lane. The filters are plain text matches on the line; leave a filter empty to ignore it. Explore runs any LogQL query against the same store.",
  "tags": ["audit"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "e.g. docint, translator, open-webui",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      },
      {
        "name": "user",
        "label": "User",
        "description": "Account name as the gateway reports it",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      },
      {
        "name": "action",
        "label": "Action",
        "description": "e.g. query, disclose, delete, auth",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Audit lines",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki-audit" },
      "gridPos": { "h": 26, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki-audit" },
          "expr": "{lane=\"audit\"} |= \"$service\" |= \"$user\" |= \"$action\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ]
    }
  ]
}
