{
  "uid": "fed-vllm",
  "title": "vLLM",
  "tags": ["federation"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests running",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, instance) (vllm:num_requests_running)",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests waiting",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, instance) (vllm:num_requests_waiting)",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prompt tokens / s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, instance) (rate(vllm:prompt_tokens_total[5m]))",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Generation tokens / s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, instance) (rate(vllm:generation_tokens_total[5m]))",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Time to first token (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, instance, le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "End-to-end request latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, instance, le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "GPU KV-cache usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, instance) (vllm:gpu_cache_usage_perc)",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    }
  ]
}
