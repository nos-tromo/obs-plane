{
  "uid": "fed-litellm",
  "title": "LiteLLM Router",
  "tags": ["federation"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(litellm_proxy_total_requests_metric_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failed requests by route and exception",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route, exception_class) (rate(litellm_proxy_failed_requests_metric_total[5m]))",
          "legendFormat": "{{route}} / {{exception_class}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "End-to-end request latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Upstream LLM API latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_llm_api_latency_metric_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Router overhead latency p95 (end-to-end minus upstream)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, model_group) (rate(litellm_overhead_latency_metric_bucket[5m])))",
          "legendFormat": "{{model_group}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Deployment responses",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (litellm_model_name) (rate(litellm_deployment_success_responses_total[5m]))",
          "legendFormat": "{{litellm_model_name}} success"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (litellm_model_name) (rate(litellm_deployment_failure_responses_total[5m]))",
          "legendFormat": "{{litellm_model_name}} failure"
        }
      ]
    },
    {
      "id": 7,
      "title": "Token throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (rate(litellm_input_tokens_metric_total[5m]))",
          "legendFormat": "{{model}} input tok/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (rate(litellm_output_tokens_metric_total[5m]))",
          "legendFormat": "{{model}} output tok/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Deployment state and in-flight requests",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "spanNulls": true } },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "litellm_deployment_state",
          "legendFormat": "state {{litellm_model_name}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "litellm_in_flight_requests",
          "legendFormat": "in-flight"
        }
      ]
    }
  ]
}
