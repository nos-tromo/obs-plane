// Discover every container on the host and ship its stdout/stderr to Loki,
// labeled by compose project + service. The Docker API is reached through
// the restricted read-only socket-proxy sidecar (deploy ADR 0001) — the
// raw socket is never mounted into this container.

discovery.docker "containers" {
  host = "tcp://socket-proxy:2375"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.redact.receiver]
}

// Redact query-string values before anything is stored. Request lines, URLs
// and referrers in access and error logs carry search terms, entity names
// and per-object access tokens as query parameters; the parameter names stay
// for debugging, every value becomes <redacted>. Applied here, centrally,
// because some sources cannot be configured not to log them: nginx's error
// log has a fixed line format, and the pulled upstream images log their own
// request URIs.
loki.process "redact" {
  forward_to = [loki.write.default.receiver]

  stage.replace {
    expression = `[?&][^=&\s"'#]+=([^&\s"'#]+)`
    replace    = "<redacted>"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
